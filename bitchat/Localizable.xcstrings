    "content.alert.bluetooth_required.off" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bluetooth متوقف. فعّل bluetooth في الإعدادات لاستخدام bitchat."
