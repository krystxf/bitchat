    "blocked_accounts.footer" : {
      "comment" : "Footer under the blocked accounts list explaining what blocking does",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع المحظورون مراسلتك وتبقى رسائلهم مخفية. ألغِ حظر شخص لتراه مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ব্লক করা লোকেরা আপনাকে বার্তা পাঠাতে পারে না এবং তাদের বার্তা লুকানো থাকে। আবার দেখতে কাউকে আনব্লক করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blockierte personen können dir nicht schreiben und ihre nachrichten bleiben verborgen. hebe eine blockierung auf, um sie wieder zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocked people can't message you and their messages stay hidden. Unblock someone to see them again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las personas bloqueadas no pueden escribirte y sus mensajes quedan ocultos. desbloquea a alguien para volver a verlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افراد مسدودشده نمی‌توانند به شما پیام دهند و پیام‌هایشان پنهان می‌ماند. برای دیدن دوباره، مسدودیت را بردارید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi ka mamemensahe ng mga naka-block at nakatago ang kanilang mga mensahe. i-unblock ang isang tao para makita silang muli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les personnes bloquées ne peuvent pas t'écrire et leurs messages restent masqués. débloque quelqu'un pour le revoir."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אנשים חסומים לא יכולים לשלוח לך הודעות וההודעות שלהם מוסתרות. בטלו חסימה כדי לראות אותם שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्लॉक किए गए लोग आपको संदेश नहीं भेज सकते और उनके संदेश छिपे रहते हैं। फिर से देखने के लिए किसी को अनब्लॉक करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang yang diblokir tidak bisa mengirimimu pesan dan pesan mereka tetap tersembunyi. buka blokir seseorang untuk melihatnya lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le persone bloccate non possono scriverti e i loro messaggi restano nascosti. sblocca qualcuno per rivederlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブロックした人はあなたにメッセージを送れず、その人のメッセージは非表示のままです。再び表示するにはブロックを解除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "차단한 사람은 메시지를 보낼 수 없고 그 사람의 메시지는 숨겨집니다. 다시 보려면 차단을 해제하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang yang disekat tidak boleh menghantar mesej kepada anda dan mesej mereka kekal tersembunyi. nyahsekat seseorang untuk melihat mereka semula."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्लक गरिएका मानिसहरूले तपाईंलाई सन्देश पठाउन सक्दैनन् र तिनका सन्देशहरू लुकेका रहन्छन्। फेरि हेर्न कसैलाई अनब्लक गर्नुहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geblokkeerde mensen kunnen je geen berichten sturen en hun berichten blijven verborgen. deblokkeer iemand om die weer te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zablokowane osoby nie mogą do ciebie pisać, a ich wiadomości pozostają ukryte. odblokuj kogoś, aby znów go widzieć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As pessoas bloqueadas não te podem enviar mensagens e as mensagens delas ficam ocultas. desbloqueia alguém para voltares a vê-lo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pessoas bloqueadas não podem te enviar mensagens e as mensagens delas ficam ocultas. desbloqueie alguém para vê-lo de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заблокированные люди не могут писать вам, а их сообщения скрыты. разблокируйте человека, чтобы снова его видеть."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blockerade personer kan inte skriva till dig och deras meddelanden förblir dolda. avblockera någon för att se dem igen."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தடுக்கப்பட்டவர்கள் உங்களுக்குச் செய்தி அனுப்ப முடியாது, அவர்களின் செய்திகள் மறைந்தே இருக்கும். மீண்டும் பார்க்க ஒருவரின் தடையை நீக்குங்கள்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คนที่ถูกบล็อกส่งข้อความหาคุณไม่ได้และข้อความของพวกเขาจะถูกซ่อน เลิกบล็อกเพื่อให้เห็นอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engellenen kişiler sana mesaj gönderemez ve mesajları gizli kalır. birini yeniden görmek için engelini kaldır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заблоковані люди не можуть писати вам, а їхні повідомлення приховано. розблокуйте когось, щоб знову бачити."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بلاک کیے گئے لوگ آپ کو پیغام نہیں بھیج سکتے اور ان کے پیغامات چھپے رہتے ہیں۔ دوبارہ دیکھنے کے لیے کسی کو ان بلاک کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Người bị chặn không thể nhắn tin cho bạn và tin nhắn của họ bị ẩn. bỏ chặn ai đó để thấy lại họ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被屏蔽的人无法给你发消息，他们的消息也会保持隐藏。取消屏蔽即可再次看到。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被封鎖的人無法傳訊息給你，他們的訊息也會保持隱藏。解除封鎖即可再次看到。"
          }
        }
      }
    },
