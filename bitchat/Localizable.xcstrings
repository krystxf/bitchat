    "app_info.settings.auto_reveal_favorites.subtitle" : {
      "comment" : "Subtitle explaining that only favorite contacts' images skip the blur",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر الصور من الأشخاص الذين وضعتهم في المفضلة فورًا. تبقى الصور من الآخرين مموهة حتى تنقر عليها. متوقف افتراضيًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যাদের প্রিয় হিসেবে চিহ্নিত করেছেন তাদের ছবি সঙ্গে সঙ্গে দেখা যায়। অন্য সবার ছবি ট্যাপ না করা পর্যন্ত ঝাপসা থাকে। ডিফল্টভাবে বন্ধ।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilder von personen, die du als favoriten markiert hast, erscheinen sofort. bilder von allen anderen bleiben unscharf, bis du sie antippst. standardmäßig aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Images from people you marked as favorites show right away. Images from everyone else stay blurred until you tap them. Off by default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las imágenes de las personas que marcaste como favoritas se muestran al instante. las del resto siguen difuminadas hasta que las toques. desactivado por defecto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصاویر افرادی که برگزیده کرده‌اید بلافاصله نمایش داده می‌شوند. تصاویر بقیه تا زمانی که روی آن‌ها ضربه بزنید تار می‌مانند. به‌طور پیش‌فرض خاموش است."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agad na lumalabas ang mga larawan mula sa mga taong minarkahan mong paborito. nananatiling malabo ang mga larawan mula sa iba hanggang i-tap mo. naka-off bilang default."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les images des personnes que tu as mises en favoris s'affichent tout de suite. celles des autres restent floutées jusqu'à ce que tu les touches. désactivé par défaut."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תמונות מאנשים שסימנת כמועדפים מוצגות מיד. תמונות מכל השאר נשארות מטושטשות עד שתקיש עליהן. כבוי כברירת מחדל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिन लोगों को आपने पसंदीदा चिह्नित किया है उनकी तस्वीरें तुरंत दिखती हैं। बाकी सभी की तस्वीरें टैप करने तक धुंधली रहती हैं। डिफ़ॉल्ट रूप से बंद।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gambar dari orang yang kamu tandai sebagai favorit langsung tampil. gambar dari orang lain tetap buram sampai kamu mengetuknya. nonaktif secara default."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le immagini delle persone che hai segnato come preferite si vedono subito. quelle di tutti gli altri restano sfocate finché non le tocchi. disattivato per impostazione predefinita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お気に入りに登録した人の画像はすぐに表示されます。それ以外の人の画像は、タップするまでぼかしたままです。初期設定はオフです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "즐겨찾기로 표시한 사람의 이미지는 바로 표시됩니다. 다른 사람의 이미지는 탭할 때까지 흐리게 유지됩니다. 기본값은 꺼짐입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imej daripada orang yang anda tandakan sebagai kegemaran dipaparkan serta-merta. imej daripada orang lain kekal kabur sehingga anda mengetiknya. dimatikan secara lalai."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईंले मनपर्ने भनी चिन्ह लगाएका मानिसहरूका तस्बिरहरू तुरुन्तै देखिन्छन्। अरू सबैका तस्बिरहरू ट्याप नगरेसम्म धमिलो रहन्छन्। पूर्वनिर्धारित रूपमा बन्द।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afbeeldingen van mensen die je als favoriet hebt gemarkeerd, verschijnen meteen. afbeeldingen van anderen blijven wazig tot je erop tikt. standaard uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrazy od osób oznaczonych jako ulubione pojawiają się od razu. obrazy od pozostałych są rozmyte, dopóki ich nie stukniesz. domyślnie wyłączone."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As imagens das pessoas que marcaste como favoritas aparecem logo. as dos restantes ficam desfocadas até lhes tocares. desativado por predefinição."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As imagens das pessoas que você marcou como favoritas aparecem na hora. as dos demais ficam desfocadas até você tocar nelas. desativado por padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изображения от людей, отмеченных как избранные, показываются сразу. изображения от остальных остаются размытыми, пока вы не коснётесь их. по умолчанию выключено."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilder från personer du har markerat som favoriter visas direkt. bilder från alla andra förblir suddiga tills du trycker på dem. av som standard."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் பிடித்தவர்களாகக் குறித்தவர்களின் படங்கள் உடனே தெரியும். மற்ற அனைவரின் படங்களும் நீங்கள் தட்டும் வரை மங்கலாக இருக்கும். இயல்பாக முடக்கப்பட்டுள்ளது."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รูปภาพจากคนที่คุณทำเครื่องหมายเป็นรายการโปรดจะแสดงทันที รูปภาพจากคนอื่นจะเบลออยู่จนกว่าคุณจะแตะ ปิดอยู่ตามค่าเริ่มต้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favori olarak işaretlediğin kişilerden gelen resimler hemen görünür. diğer herkesin resimleri dokunana kadar bulanık kalır. varsayılan olarak kapalı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зображення від людей, позначених як обрані, показуються одразу. зображення від інших лишаються розмитими, доки ви їх не торкнетеся. типово вимкнено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جن لوگوں کو آپ نے پسندیدہ نشان زد کیا ہے ان کی تصاویر فوراً دکھائی دیتی ہیں۔ باقی سب کی تصاویر ٹیپ کرنے تک دھندلی رہتی ہیں۔ بطور ڈیفالٹ بند۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hình ảnh từ những người bạn đánh dấu là yêu thích sẽ hiện ngay. hình ảnh từ những người khác vẫn bị làm mờ cho đến khi bạn chạm vào. tắt theo mặc định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你标为收藏的人发来的图片会直接显示。其他人的图片在你点按之前保持模糊。默认关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你標為最愛的人傳來的圖片會直接顯示。其他人的圖片在你點按前保持模糊。預設為關閉。"
          }
        }
      }
    },
