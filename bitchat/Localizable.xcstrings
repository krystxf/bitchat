    "verification.scan.camera_unavailable.message" : {
      "comment" : "Shown on iPhone under 'Camera Unavailable' over the QR scanner preview, above a button that opens Settings",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالوصول إلى الكاميرا في الإعدادات لمسح رمز صديقك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বন্ধুর কোড স্ক্যান করতে সেটিংসে ক্যামেরা অ্যাক্সেসের অনুমতি দিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube in den Einstellungen den Kamerazugriff, um den Code eines Freundes zu scannen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow camera access in Settings to scan a friend's code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso a la cámara en Ajustes para escanear el código de un amigo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای اسکن کد دوستتان، در تنظیمات اجازهٔ دسترسی به دوربین را بدهید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payagan ang access sa camera sa Settings para ma-scan ang code ng kaibigan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l'accès à l'appareil photo dans les Réglages pour scanner le code d'un ami."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לאפשר גישה למצלמה בהגדרות כדי לסרוק את הקוד של חבר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी मित्र का कोड स्कैन करने के लिए सेटिंग्स में कैमरा एक्सेस की अनुमति दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan akses kamera di Pengaturan untuk memindai kode teman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti l'accesso alla fotocamera in Impostazioni per scansionare il codice di un amico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "友達のコードをスキャンするには、設定でカメラへのアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "친구의 코드를 스캔하려면 설정에서 카메라 접근을 허용하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benarkan akses kamera dalam Tetapan untuk mengimbas kod rakan."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साथीको कोड स्क्यान गर्न सेटिङमा क्यामेरा पहुँचको अनुमति दिनुहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta cameratoegang toe in Instellingen om de code van een vriend te scannen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwól na dostęp do aparatu w Ustawieniach, aby zeskanować kod znajomego."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o acesso à câmara nas Definições para ler o código de um amigo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o acesso à câmera nos Ajustes para escanear o código de um amigo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите доступ к камере в настройках, чтобы отсканировать код друга."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåt kameraåtkomst i Inställningar för att skanna en väns kod."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நண்பரின் குறியீட்டை ஸ்கேன் செய்ய அமைப்புகளில் கேமரா அணுகலை அனுமதிக்கவும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุญาตการเข้าถึงกล้องในการตั้งค่าเพื่อสแกนรหัสของเพื่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir arkadaşının kodunu taramak için Ayarlar'da kamera erişimine izin ver."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозвольте доступ до камери в налаштуваннях, щоб відсканувати код друга."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کسی دوست کا کوڈ اسکین کرنے کے لیے ترتیبات میں کیمرے تک رسائی کی اجازت دیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép truy cập camera trong Cài đặt để quét mã của bạn bè."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在设置中允许访问相机，以扫描朋友的验证码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在設定中允許取用相機，以掃描朋友的驗證碼。"
          }
        }
      }
    },
    "verification.scan.camera_unavailable.message_macos" : {
      "comment" : "Shown on Mac under 'Camera Unavailable' over the QR scanner preview; a paste field follows below it",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصق رابط التحقق الخاص بصديقك أدناه بدلًا من ذلك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এর বদলে নিচে বন্ধুর যাচাইকরণ লিঙ্ক পেস্ট করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge stattdessen unten den Bestätigungslink eines Freundes ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste a friend's verification link below instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega abajo el enlace de verificación de un amigo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به‌جای آن، پیوند تأیید دوستتان را در پایین جای‌گذاری کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-paste na lang sa ibaba ang verification link ng kaibigan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collez plutôt ci-dessous le lien de vérification d'un ami."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "במקום זאת, הדביקו למטה את קישור האימות של חבר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके बजाय नीचे किसी मित्र का सत्यापन लिंक पेस्ट करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempel tautan verifikasi teman di bawah sebagai gantinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incolla invece qui sotto il link di verifica di un amico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代わりに、友達の確認リンクを下に貼り付けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대신 아래에 친구의 인증 링크를 붙여넣으세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampal pautan pengesahan rakan di bawah sebagai ganti."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बरु तल साथीको प्रमाणीकरण लिङ्क टाँस्नुहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plak in plaats daarvan hieronder de verificatielink van een vriend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamiast tego wklej poniżej link weryfikacyjny znajomego."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em alternativa, cole abaixo a ligação de verificação de um amigo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em vez disso, cole abaixo o link de verificação de um amigo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вместо этого вставьте ниже ссылку для проверки от друга."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klistra in en väns verifieringslänk nedan i stället."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அதற்குப் பதிலாக நண்பரின் சரிபார்ப்பு இணைப்பைக் கீழே ஒட்டவும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วางลิงก์ยืนยันของเพื่อนด้านล่างแทน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunun yerine bir arkadaşının doğrulama bağlantısını aşağıya yapıştır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натомість вставте нижче посилання для перевірки від друга."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس کے بجائے نیچے کسی دوست کا تصدیقی لنک پیسٹ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thay vào đó, hãy dán liên kết xác minh của bạn bè bên dưới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也可以在下方粘贴朋友的验证链接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也可以在下方貼上朋友的驗證連結。"
          }
        }
      }
    },
