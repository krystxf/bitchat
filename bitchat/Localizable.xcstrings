    "app_info.settings.extreme_security.subtitle_ios" : {
      "comment" : "Subtitle of the extreme security mode setting on iPhone and iPad: what is deleted when the user leaves the app (goes home or switches apps) and what stays",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف كل رسالة وصورة وملاحظة صوتية فور مغادرتك التطبيق. تبقى هويتك وجهات اتصالك وإعداداتك. متوقف افتراضيًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপ ছেড়ে যাওয়ার সঙ্গে সঙ্গে প্রতিটি বার্তা, ছবি ও ভয়েস নোট মুছে ফেলে। আপনার পরিচয়, পরিচিতি ও সেটিংস থেকে যায়। ডিফল্টভাবে বন্ধ।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht jede nachricht, jedes bild und jede sprachnachricht, sobald du die app verlässt. deine identität, kontakte und einstellungen bleiben. standardmäßig aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes every message, image and voice note as soon as you leave the app. Your identity, contacts and settings stay. Off by default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra todos los mensajes, imágenes y notas de voz en cuanto sales de la app. tu identidad, tus contactos y tus ajustes se quedan. desactivado por defecto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به محض اینکه از برنامه بیرون بروی، همهٔ پیام‌ها، تصاویر و پیام‌های صوتی را پاک می‌کند. هویت، مخاطبان و تنظیماتت باقی می‌مانند. به‌طور پیش‌فرض خاموش."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binubura ang bawat mensahe, larawan at voice note sa sandaling umalis ka sa app. nananatili ang iyong pagkakakilanlan, mga contact at setting. naka-off bilang default."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime chaque message, image et note vocale dès que tu quittes l'app. ton identité, tes contacts et tes réglages restent. désactivé par défaut."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוחק כל הודעה, תמונה והערה קולית ברגע שיוצאים מהאפליקציה. הזהות, אנשי הקשר וההגדרות שלך נשארים. כבוי כברירת מחדל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप छोड़ते ही हर संदेश, तस्वीर और वॉइस नोट मिटा देता है। आपकी पहचान, संपर्क और सेटिंग्स बनी रहती हैं। डिफ़ॉल्ट रूप से बंद।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus setiap pesan, gambar, dan catatan suara begitu kamu keluar dari aplikasi. identitas, kontak, dan pengaturanmu tetap ada. nonaktif secara bawaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina ogni messaggio, immagine e nota vocale appena esci dall'app. la tua identità, i contatti e le impostazioni restano. disattivato per impostazione predefinita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを離れるとすぐに、すべてのメッセージ、画像、ボイスメモを削除します。アイデンティティ、連絡先、設定は残ります。初期設定はオフです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 나가는 즉시 모든 메시지, 이미지, 음성 메모를 삭제합니다. 신원, 연락처, 설정은 그대로 남습니다. 기본값은 꺼짐입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memadam setiap mesej, imej dan nota suara sebaik sahaja kamu meninggalkan aplikasi. identiti, kenalan dan tetapanmu kekal. mati secara lalai."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एप छोड्नेबित्तिकै हरेक सन्देश, तस्बिर र भ्वाइस नोट मेटाउँछ। तिम्रो परिचय, सम्पर्क र सेटिङहरू रहन्छन्। पूर्वनिर्धारित रूपमा अफ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wist elk bericht, elke afbeelding en elk spraakbericht zodra je de app verlaat. je identiteit, contacten en instellingen blijven. standaard uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa każdą wiadomość, obraz i notatkę głosową, gdy tylko opuścisz aplikację. twoja tożsamość, kontakty i ustawienia zostają. domyślnie wyłączone."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga todas as mensagens, imagens e notas de voz assim que sais da app. a tua identidade, os contactos e as definições ficam. desligado por predefinição."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga todas as mensagens, imagens e mensagens de voz assim que você sai do app. sua identidade, seus contatos e suas configurações ficam. desligado por padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет все сообщения, изображения и голосовые сообщения, как только вы выходите из приложения. ваша идентичность, контакты и настройки остаются. по умолчанию выключено."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raderar varje meddelande, bild och röstmeddelande så fort du lämnar appen. din identitet, dina kontakter och inställningar finns kvar. av som standard."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஆப்பை விட்டு வெளியேறியவுடன் ஒவ்வொரு செய்தி, படம், குரல் குறிப்பையும் நீக்கும். உங்கள் அடையாளம், தொடர்புகள், அமைப்புகள் அப்படியே இருக்கும். இயல்பாக முடக்கத்தில் உள்ளது."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบทุกข้อความ รูปภาพ และข้อความเสียงทันทีที่คุณออกจากแอป ตัวตน รายชื่อติดต่อ และการตั้งค่าของคุณยังอยู่ ปิดไว้เป็นค่าเริ่มต้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamadan çıktığın anda her mesajı, resmi ve sesli notu siler. kimliğin, kişilerin ve ayarların kalır. varsayılan olarak kapalı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видаляє кожне повідомлення, зображення й голосову нотатку, щойно ти виходиш із застосунку. твоя ідентичність, контакти й налаштування лишаються. типово вимкнено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایپ چھوڑتے ہی ہر پیغام، تصویر اور وائس نوٹ مٹا دیتا ہے۔ آپ کی شناخت، رابطے اور سیٹنگز برقرار رہتی ہیں۔ بطور طے شدہ بند ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa mọi tin nhắn, hình ảnh và ghi chú giọng nói ngay khi bạn rời ứng dụng. danh tính, danh bạ và cài đặt của bạn vẫn giữ nguyên. tắt theo mặc định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一离开应用，就删除所有消息、图片和语音消息。你的身份、联系人和设置都会保留。默认关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一離開 app，就刪除所有訊息、圖片和語音訊息。你的身分、聯絡人和設定都會保留。預設關閉。"
          }
        }
      }
    },
    "app_info.settings.extreme_security.subtitle_macos" : {
      "comment" : "Subtitle of the extreme security mode setting on Mac: what is deleted when the user quits the app or closes its window, and what stays",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف كل رسالة وصورة وملاحظة صوتية عند إنهاء التطبيق أو إغلاق نافذته. تبقى هويتك وجهات اتصالك وإعداداتك. متوقف افتراضيًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপ বন্ধ করলে বা এর উইন্ডো বন্ধ করলে প্রতিটি বার্তা, ছবি ও ভয়েস নোট মুছে ফেলে। আপনার পরিচয়, পরিচিতি ও সেটিংস থেকে যায়। ডিফল্টভাবে বন্ধ।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht jede nachricht, jedes bild und jede sprachnachricht, wenn du die app beendest oder ihr fenster schließt. deine identität, kontakte und einstellungen bleiben. standardmäßig aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes every message, image and voice note when you quit the app or close its window. Your identity, contacts and settings stay. Off by default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra todos los mensajes, imágenes y notas de voz cuando cierras la app o su ventana. tu identidad, tus contactos y tus ajustes se quedan. desactivado por defecto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقتی از برنامه خارج شوی یا پنجره‌اش را ببندی، همهٔ پیام‌ها، تصاویر و پیام‌های صوتی را پاک می‌کند. هویت، مخاطبان و تنظیماتت باقی می‌مانند. به‌طور پیش‌فرض خاموش."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binubura ang bawat mensahe, larawan at voice note kapag isinara mo ang app o ang window nito. nananatili ang iyong pagkakakilanlan, mga contact at setting. naka-off bilang default."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime chaque message, image et note vocale quand tu quittes l'app ou fermes sa fenêtre. ton identité, tes contacts et tes réglages restent. désactivé par défaut."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוחק כל הודעה, תמונה והערה קולית כשסוגרים את האפליקציה או את החלון שלה. הזהות, אנשי הקשר וההגדרות שלך נשארים. כבוי כברירת מחדל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप बंद करने या उसकी विंडो बंद करने पर हर संदेश, तस्वीर और वॉइस नोट मिटा देता है। आपकी पहचान, संपर्क और सेटिंग्स बनी रहती हैं। डिफ़ॉल्ट रूप से बंद।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus setiap pesan, gambar, dan catatan suara saat kamu keluar dari aplikasi atau menutup jendelanya. identitas, kontak, dan pengaturanmu tetap ada. nonaktif secara bawaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina ogni messaggio, immagine e nota vocale quando chiudi l'app o la sua finestra. la tua identità, i contatti e le impostazioni restano. disattivato per impostazione predefinita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを終了するかウインドウを閉じると、すべてのメッセージ、画像、ボイスメモを削除します。アイデンティティ、連絡先、設定は残ります。初期設定はオフです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 종료하거나 창을 닫으면 모든 메시지, 이미지, 음성 메모를 삭제합니다. 신원, 연락처, 설정은 그대로 남습니다. 기본값은 꺼짐입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memadam setiap mesej, imej dan nota suara apabila kamu keluar daripada aplikasi atau menutup tetingkapnya. identiti, kenalan dan tetapanmu kekal. mati secara lalai."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एप बन्द गर्दा वा यसको विन्डो बन्द गर्दा हरेक सन्देश, तस्बिर र भ्वाइस नोट मेटाउँछ। तिम्रो परिचय, सम्पर्क र सेटिङहरू रहन्छन्। पूर्वनिर्धारित रूपमा अफ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wist elk bericht, elke afbeelding en elk spraakbericht wanneer je de app stopt of het venster sluit. je identiteit, contacten en instellingen blijven. standaard uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa każdą wiadomość, obraz i notatkę głosową, gdy zamkniesz aplikację lub jej okno. twoja tożsamość, kontakty i ustawienia zostają. domyślnie wyłączone."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga todas as mensagens, imagens e notas de voz quando sais da app ou fechas a janela. a tua identidade, os contactos e as definições ficam. desligado por predefinição."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga todas as mensagens, imagens e mensagens de voz quando você encerra o app ou fecha a janela. sua identidade, seus contatos e suas configurações ficam. desligado por padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет все сообщения, изображения и голосовые сообщения, когда вы закрываете приложение или его окно. ваша идентичность, контакты и настройки остаются. по умолчанию выключено."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raderar varje meddelande, bild och röstmeddelande när du avslutar appen eller stänger dess fönster. din identitet, dina kontakter och inställningar finns kvar. av som standard."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஆப்பை மூடும்போது அல்லது அதன் சாளரத்தை மூடும்போது ஒவ்வொரு செய்தி, படம், குரல் குறிப்பையும் நீக்கும். உங்கள் அடையாளம், தொடர்புகள், அமைப்புகள் அப்படியே இருக்கும். இயல்பாக முடக்கத்தில் உள்ளது."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบทุกข้อความ รูปภาพ และข้อความเสียงเมื่อคุณออกจากแอปหรือปิดหน้าต่างของแอป ตัวตน รายชื่อติดต่อ และการตั้งค่าของคุณยังอยู่ ปิดไว้เป็นค่าเริ่มต้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamadan çıktığında ya da penceresini kapattığında her mesajı, resmi ve sesli notu siler. kimliğin, kişilerin ve ayarların kalır. varsayılan olarak kapalı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видаляє кожне повідомлення, зображення й голосову нотатку, коли ти закриваєш застосунок або його вікно. твоя ідентичність, контакти й налаштування лишаються. типово вимкнено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایپ بند کرنے یا اس کی ونڈو بند کرنے پر ہر پیغام، تصویر اور وائس نوٹ مٹا دیتا ہے۔ آپ کی شناخت، رابطے اور سیٹنگز برقرار رہتی ہیں۔ بطور طے شدہ بند ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa mọi tin nhắn, hình ảnh và ghi chú giọng nói khi bạn thoát ứng dụng hoặc đóng cửa sổ của nó. danh tính, danh bạ và cài đặt của bạn vẫn giữ nguyên. tắt theo mặc định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出应用或关闭其窗口时，删除所有消息、图片和语音消息。你的身份、联系人和设置都会保留。默认关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結束 app 或關閉其視窗時，刪除所有訊息、圖片和語音訊息。你的身分、聯絡人和設定都會保留。預設關閉。"
          }
        }
      }
    },
