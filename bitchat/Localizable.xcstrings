    "voice.recorder.hint.swipe_to_cancel" : {
      "comment" : "Hint above the voice recording bar while holding the mic button; the trash can sits on the leading side, so right-to-left languages swipe right",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
