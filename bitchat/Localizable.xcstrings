        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডিসেন্ট্রালাইজড বেনামি রিলে দিয়ে কাছাকাছি অঞ্চলের মানুষের সাথে কথা বলার জন্য জিওহ্যাশ চ্যানেল"
