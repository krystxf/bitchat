    "conversation_info.block.message" : {
      "comment" : "Message of the confirmation before blocking a person from their details page",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن ترى رسائل هذا الشخص بعد الآن. يمكنك إلغاء الحظر من الإعدادات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি আর এই ব্যক্তির বার্তা দেখবেন না। সেটিংসে গিয়ে আনব্লক করতে পারবেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du siehst die Nachrichten dieser Person nicht mehr. In den Einstellungen kannst du sie wieder entsperren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will no longer see their messages. You can unblock them in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya no verás sus mensajes. Puedes desbloquear a esta persona en Ajustes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دیگر پیام‌های این شخص را نمی‌بینید. می‌توانید در تنظیمات رفع مسدودیت کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi mo na makikita ang kanilang mga mensahe. Maaari mo silang i-unblock sa Settings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ne verras plus ses messages. Tu peux le débloquer dans les Réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא תראו יותר את ההודעות של האדם הזה. אפשר לבטל את החסימה בהגדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपको इनके संदेश अब नहीं दिखेंगे। आप सेटिंग्स में इन्हें अनब्लॉक कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu tidak akan melihat pesan mereka lagi. Kamu bisa membuka blokir di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non vedrai più i suoi messaggi. Puoi sbloccare questa persona nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相手のメッセージは表示されなくなります。ブロックは設定で解除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 사람의 메시지가 더 이상 표시되지 않습니다. 설정에서 차단을 해제할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda tidak akan melihat mesej mereka lagi. Anda boleh buka blokir dalam Tetapan."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तपाईंले अब यिनका सन्देशहरू देख्नुहुने छैन। सेटिङमा गएर अनब्लक गर्न सक्नुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ziet hun berichten niet meer. In Instellingen kun je ze weer deblokkeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie zobaczysz już wiadomości tej osoby. Możesz ją odblokować w Ustawieniach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixas de ver as mensagens dessa pessoa. Podes desbloqueá-la nas Definições."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não vai mais ver as mensagens dessa pessoa. Dá para desbloquear nos Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщения этого человека больше не будут показываться. Разблокировать можно в настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du ser inte längre personens meddelanden. Du kan avblockera i Inställningar."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இனி இவரின் செய்திகள் உங்களுக்குத் தெரியாது. அமைப்புகளில் தடையை நீக்கலாம்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะไม่เห็นข้อความของคนนี้อีก เลิกบล็อกได้ในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artık mesajlarını görmeyeceksin. Engeli Ayarlar'dan kaldırabilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повідомлення цієї людини більше не показуватимуться. Розблокувати можна в налаштуваннях."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کو ان کے پیغامات مزید نظر نہیں آئیں گے۔ آپ سیٹنگز میں انہیں ان بلاک کر سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn sẽ không còn thấy tin nhắn của người này. Bạn có thể bỏ chặn trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你将不再看到对方的消息。可以在设置中取消屏蔽。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你將不再看到對方的訊息。可以在設定中取消屏蔽。"
          }
        }
      }
    },
