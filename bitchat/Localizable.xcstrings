        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボイスメモはメッシュチャットでのみ利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 메모는 메쉬 채팅에서만 사용할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota suara hanya tersedia dalam sembang mesh."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
