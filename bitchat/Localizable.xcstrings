        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הקש הקשה כפולה כדי להתחיל הקלטה, הקש שוב כדי לשלוח"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "रिकॉर्डिंग शुरू करने के लिए दो बार टैप करें, भेजने के लिए फिर दो बार टैप करें"
          }
        },
        "id" : {
          "stringUnit" : {
