        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটা একটা পাবলিক চ্যানেল — যে কেউ পড়ে টোকেনটা ভাঙিয়ে নিতে পারে। তবুও পাঠাতে: /pay <টোকেন> public"
          }
