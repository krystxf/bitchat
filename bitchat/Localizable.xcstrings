    "app_info.settings.extreme_security.confirm_message" : {
      "comment" : "Message of the confirmation dialog before extreme security mode is turned on: deleted messages are gone for good, and undelivered outgoing messages are dropped",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن استعادة الرسائل المحذوفة، ولا حتى بواسطتك. وتُحذف أيضًا الرسائل التي لم تصل بعد إلى مستلمها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মুছে ফেলা বার্তা আর ফেরত পাওয়া যায় না, এমনকি আপনিও পারবেন না। যে বার্তাগুলো এখনও প্রাপকের কাছে পৌঁছায়নি, সেগুলোও বাদ পড়ে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelöschte nachrichten lassen sich nicht wiederherstellen, auch nicht von dir. nachrichten, die ihr ziel noch nicht erreicht haben, werden ebenfalls verworfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleted messages can't be recovered, not even by you. Messages that haven't reached their recipient yet are dropped too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mensajes borrados no se pueden recuperar, ni siquiera tú. los mensajes que aún no han llegado a su destinatario también se descartan."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیام‌های پاک‌شده قابل بازیابی نیستند، حتی برای خودت. پیام‌هایی که هنوز به گیرنده نرسیده‌اند هم کنار گذاشته می‌شوند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi na maibabalik ang mga nabura na mensahe, kahit ikaw. ibinabasura rin ang mga mensaheng hindi pa nakakarating sa tatanggap."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les messages supprimés sont irrécupérables, même pour toi. les messages qui n'ont pas encore atteint leur destinataire sont aussi abandonnés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אי אפשר לשחזר הודעות שנמחקו, גם לא בעצמך. גם הודעות שעוד לא הגיעו לנמען נזרקות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मिटाए गए संदेश वापस नहीं आ सकते, आप भी उन्हें वापस नहीं ला सकते। जो संदेश अभी तक प्राप्तकर्ता तक नहीं पहुँचे हैं, वे भी हटा दिए जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesan yang dihapus tidak bisa dipulihkan, bahkan olehmu. pesan yang belum sampai ke penerimanya juga dibuang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I messaggi eliminati non si possono recuperare, nemmeno da te. anche i messaggi che non hanno ancora raggiunto il destinatario vengono scartati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除したメッセージは、あなた自身でも復元できません。まだ相手に届いていないメッセージも破棄されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "삭제된 메시지는 본인도 복구할 수 없습니다. 아직 받는 사람에게 도착하지 않은 메시지도 버려집니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesej yang dipadam tidak boleh dipulihkan, walaupun olehmu. mesej yang belum sampai kepada penerimanya juga dibuang."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेटिएका सन्देशहरू फिर्ता ल्याउन सकिँदैन, तिमीले पनि सक्दैनौ। प्रापकसम्म नपुगेका सन्देशहरू पनि हटाइन्छन्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewiste berichten zijn niet terug te halen, ook niet door jou. berichten die hun ontvanger nog niet hebben bereikt, vervallen ook."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuniętych wiadomości nie da się odzyskać, nawet tobie. wiadomości, które jeszcze nie dotarły do odbiorcy, też przepadają."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As mensagens apagadas não podem ser recuperadas, nem por ti. as mensagens que ainda não chegaram ao destinatário também são descartadas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mensagens apagadas não podem ser recuperadas, nem por você. mensagens que ainda não chegaram ao destinatário também são descartadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённые сообщения нельзя восстановить, даже вам. сообщения, которые ещё не дошли до получателя, тоже пропадут."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raderade meddelanden går inte att återställa, inte ens för dig. meddelanden som ännu inte nått mottagaren slängs också."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீக்கப்பட்ட செய்திகளை மீட்டெடுக்க முடியாது, உங்களாலும் முடியாது. இன்னும் பெறுநரை அடையாத செய்திகளும் கைவிடப்படும்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อความที่ลบแล้วกู้คืนไม่ได้ แม้แต่ตัวคุณเอง ข้อความที่ยังไปไม่ถึงผู้รับก็จะถูกทิ้งด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silinen mesajlar geri getirilemez, senin tarafından bile. henüz alıcısına ulaşmamış mesajlar da atılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видалені повідомлення не можна відновити, навіть тобі. повідомлення, які ще не дійшли до отримувача, теж пропадуть."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مٹائے گئے پیغامات واپس نہیں آ سکتے، آپ بھی انہیں واپس نہیں لا سکتے۔ جو پیغامات ابھی وصول کنندہ تک نہیں پہنچے، وہ بھی ہٹا دیے جاتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tin nhắn đã xóa không thể khôi phục, kể cả với bạn. tin nhắn chưa đến người nhận cũng bị bỏ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除的消息无法恢复，你自己也不行。尚未送达收件人的消息也会被丢弃。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除的訊息無法復原，你自己也不行。尚未送達收件人的訊息也會被捨棄。"
          }
        }
      }
    },
