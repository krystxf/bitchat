    "profile.nickname.footer" : {
      "comment" : "Footer under the nickname field in the profile sheet",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرى الأشخاص القريبون هذا الاسم بجانب رسائلك. يمكنك تغييره في أي وقت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কাছের মানুষেরা আপনার বার্তার পাশে এই নাম দেখেন। আপনি যেকোনো সময় এটি বদলাতে পারেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leute in der nähe sehen diesen namen neben deinen nachrichten. du kannst ihn jederzeit ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "People nearby see this name next to your messages. You can change it any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las personas cercanas ven este nombre junto a tus mensajes. puedes cambiarlo cuando quieras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افراد نزدیک این نام را کنار پیام‌های شما می‌بینند. هر زمان بخواهید می‌توانید آن را تغییر دهید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakikita ng mga tao sa malapit ang pangalang ito sa tabi ng iyong mga mensahe. mapapalitan mo ito anumang oras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les personnes à proximité voient ce nom à côté de tes messages. tu peux le changer à tout moment."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אנשים בקרבת מקום רואים את השם הזה לצד ההודעות שלך. אפשר לשנות אותו בכל עת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आस-पास के लोग आपके संदेशों के साथ यह नाम देखते हैं। आप इसे कभी भी बदल सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang di sekitar melihat nama ini di samping pesanmu. kamu bisa mengubahnya kapan saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le persone vicine vedono questo nome accanto ai tuoi messaggi. puoi cambiarlo quando vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近くの人には、メッセージの横にこの名前が表示されます。いつでも変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "근처 사람들은 메시지 옆에서 이 이름을 봅니다. 언제든지 바꿀 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang berdekatan melihat nama ini di sebelah mesej anda. anda boleh menukarnya bila-bila masa."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नजिकका मानिसहरूले तपाईंका सन्देशहरूसँगै यो नाम देख्छन्। तपाईं यसलाई जुनसुकै बेला बदल्न सक्नुहुन्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mensen in de buurt zien deze naam naast je berichten. je kunt hem altijd wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoby w pobliżu widzą tę nazwę obok twoich wiadomości. możesz ją zmienić w każdej chwili."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As pessoas por perto veem este nome junto às tuas mensagens. podes mudá-lo quando quiseres."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As pessoas por perto veem este nome ao lado das suas mensagens. você pode mudá-lo quando quiser."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Люди поблизости видят это имя рядом с вашими сообщениями. его можно изменить в любой момент."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personer i närheten ser det här namnet bredvid dina meddelanden. du kan ändra det när som helst."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அருகிலுள்ளவர்கள் உங்கள் செய்திகளுக்கு அருகில் இந்தப் பெயரைப் பார்ப்பார்கள். எப்போது வேண்டுமானாலும் மாற்றலாம்."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คนที่อยู่ใกล้เคียงจะเห็นชื่อนี้ข้างข้อความของคุณ คุณเปลี่ยนได้ทุกเมื่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakındaki kişiler bu adı mesajlarının yanında görür. istediğin zaman değiştirebilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Люди поблизу бачать це ім’я поруч із вашими повідомленнями. його можна змінити будь-коли."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قریب کے لوگ یہ نام آپ کے پیغامات کے ساتھ دیکھتے ہیں۔ آپ اسے کسی بھی وقت بدل سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những người ở gần thấy tên này bên cạnh tin nhắn của bạn. bạn có thể đổi tên bất cứ lúc nào."
          }
        },
        "zh-Hans" : {
